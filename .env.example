# OpenAI-compatible embedding provider.
# provider: openai (real embeddings) or mock (deterministic local vectors, no API key needed)
EMBEDDINGS_PROVIDER=openai

# Required when EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
# Optional: override for OpenAI-compatible gateways
# OPENAI_BASE_URL=https://api.openai.com/v1

# Embedding model and vector dimension. text-embedding-3-small => 1536
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge

# Knowledge base source (source of truth)
KB_SOURCE_DIR=kb/source

# Search
SEARCH_TOP_K=5
# Candidate pool per branch for hybrid RRF prefetch (must be >= SEARCH_TOP_K)
SEARCH_PREFETCH_LIMIT=20

# Eval: retrieval depth used to compute Recall@10/@20 (Hit@k/MRR still use SEARCH_TOP_K)
EVAL_CANDIDATE_DEPTH=20

# Reranker provider: local | voyage | cohere | fallback
#   local    self-hosted cross-encoder at RERANKER_URL (see reranker/app.py)
#   voyage   Voyage rerank API (needs VOYAGE_API_KEY)
#   cohere   Cohere rerank API (needs COHERE_API_KEY)
#   fallback built-in lexical scorer (pipeline stays runnable, no model)
RERANKER_PROVIDER=local
RERANKER_URL=http://localhost:8080
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Candidates fetched per branch (dense and BM25) before the union + rerank
RERANK_CANDIDATES=20
RERANK_TIMEOUT_MS=120000

# Voyage rerank API (provider=voyage)
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com
VOYAGE_RERANK_MODEL=rerank-3-lite

# Cohere rerank API (provider=cohere)
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com
COHERE_RERANK_MODEL=rerank-v4.0-fast

# Web UI
PORT=3000
